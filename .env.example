# Snap Crackle Pop Trivia - Environment Configuration 💥⚡🍿

# GEMINI_API_KEY: (Optional but recommended)
# Enables Tier-1 live Google Search Grounding for breaking news and custom topics,
# as well as high-fidelity neural host voice synthesis.
# If omitted or offline, the app automatically falls back to OpenTriviaDB and local speech synthesis!
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Port to run the Express + Vite server on (defaults to 3000)
PORT=3000

# APP_URL: Optional public host URL for websocket client connections
APP_URL="http://localhost:3000"
