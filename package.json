{
  "name": "snap-crackle-trivia",
  "version": "1.0.0",
  "description": "Snap Crackle Pop Trivia! 💥⚡🍿 - High-energy arcade game-show trivia featuring reactive AI hosts, a local 500-question weekly bank refreshed via Google, voice narration, wagering, streak multipliers, and real-time multiplayer.",
  "keywords": [
    "trivia",
    "game-show",
    "gemini-api",
    "react",
    "typescript",
    "tailwindcss",
    "websockets",
    "voice-synthesis",
    "multiplayer",
    "arcade-game"
  ],
  "author": "bluegrouse92-lgtm",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/bluegrouse92-lgtm/snap-crackle-trivia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluegrouse92-lgtm/snap-crackle-trivia.git"
  },
  "bugs": {
    "url": "https://github.com/bluegrouse92-lgtm/snap-crackle-trivia/issues"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "update-questions": "tsx scripts/updateWeeklyQuestions.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
